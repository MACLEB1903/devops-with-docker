FROM node:16-alpine AS build
WORKDIR /usr/src/app

COPY app/hello-frontend/package*.json ./
COPY app/hello-frontend/. .

ARG REACT_APP_BACKEND_URL=http://localhost:8080
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}

RUN npm install && \
    npm run build


FROM node:16-alpine
WORKDIR /usr/src/app

RUN npm install -g serve && \
    adduser -D appuser && \
    chown -R appuser:appuser /usr/src/app

COPY --from=build --chown=appuser:appuser /usr/src/app/build ./build

USER appuser

EXPOSE 5001
CMD ["serve", "-s", "-l", "5001", "build"]
