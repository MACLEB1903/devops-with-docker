FROM golang:alpine AS builder
WORKDIR /usr/src/app

COPY app/hello-backend/go.mod app/hello-backend/go.sum ./
COPY app/hello-backend/. ./

RUN go mod download && \
    go build && \
    go test ./... 


FROM scratch
WORKDIR /usr/src/app

COPY --from=builder /usr/src/app/server ./server

USER 10001:10001

ARG REQUEST_ORIGIN=http://localhost:5001
ENV REQUEST_ORIGIN=${REQUEST_ORIGIN}

ARG PORT=8080
ENV PORT=${PORT}
EXPOSE $PORT

CMD ["./server"]

